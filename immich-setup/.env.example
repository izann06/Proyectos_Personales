# =============================================================================
# 🖼️ CONFIGURACIÓN DE IMMICH
# =============================================================================
# Este archivo contiene las variables que usa el docker-compose.yml.
# Solo necesitas cambiar las de arriba. Las de abajo déjalas como están.
# =============================================================================


# =============================================================================
# 📂 LO QUE TÚ PUEDES (Y DEBES) CAMBIAR
# =============================================================================

# ¿Dónde quieres que se guarden las fotos y vídeos de tu móvil?
UPLOAD_LOCATION=E:\DarkPassenger_Backup\Immich

# Contraseña de la base de datos interna.
DB_PASSWORD=postgres


# =============================================================================
# ⚙️ CONFIGURACIÓN INTERNA (NO TOCAR)
# =============================================================================

# Dónde se guardan los datos técnicos (no las fotos) de la base de datos
DB_DATA_LOCATION=./immich-postgres-data

# Versión de Immich (release = siempre la última estable)
IMMICH_VERSION=release

# Conexión interna entre los servicios de Docker
DB_HOSTNAME=database
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
REDIS_HOSTNAME=redis
